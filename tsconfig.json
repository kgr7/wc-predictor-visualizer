{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*",
    "tests/standings.test.ts",
    "tests/parser.test.ts"
  ],
  "exclude": [
    "src/web/**/*",
    "src/**/*.test.ts"
  ]
}